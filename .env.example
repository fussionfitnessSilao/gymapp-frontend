# Copia este archivo a .env y ajusta los valores. Nunca subas .env real al repositorio.

SECRET_KEY=cambia-esto-por-una-clave-secreta-larga-y-aleatoria
DEFAULT_GYM_NAME=Estudio Boutique

# Formato: postgres://usuario:password@host:puerto/nombre_db
DATABASE_URL=postgres://gymapp:gymapp@db:5432/gymapp

# Solo se usa en config.settings.prod
ALLOWED_HOSTS=tu-dominio.com

CORS_ALLOWED_ORIGINS=http://localhost:5173

# Se usarán en el módulo de Notificaciones (Fase 9, más adelante)
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Recuperación de contraseña por correo, vía Brevo (verificas el
# remitente con un código de 6 dígitos al correo — sin dominio ni
# verificación de teléfono). API HTTP, no SMTP: el plan gratis de Render
# bloquea los puertos SMTP de salida. Sin llenar, los correos se imprimen
# en los logs del proceso en vez de enviarse de verdad.
BREVO_API_KEY=
DEFAULT_FROM_EMAIL=
